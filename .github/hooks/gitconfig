# Git 2.54+ config-based hooks for upaygo.
#
# Enable once per clone (paths are relative to .git/):
#   git config --local include.path ../.github/hooks/gitconfig
#
# Verify:
#   git hook list --show-scope pre-commit   # registration only; does not execute
#   git hook run pre-commit                 # runs configured commands
#
# Docs: https://git-scm.com/docs/git-hook
#
# Note: unquoted ';' starts a comment in gitconfig — quote values that need it.

[hook "swagger"]
	event = pre-commit
	command = "bash -c 'if command -v swag >/dev/null 2>&1; then swag init; else go run github.com/swaggo/swag/cmd/swag@latest init; fi'"

[hook "stripe-legacy-api"]
	event = pre-commit
	command = "bash -c 'matches=$(grep -RnE --include=\"*.go\" --exclude-dir=vendor \"stripe\\.Key|stripe-go/v82/(paymentintent|customer)\\b\" . || true); test -z \"$matches\" || { echo \"Legacy stripe-go API usage found, use stripe.Client via appconfig.GetStripeClientByCurrency:\"; echo \"$matches\"; exit 1; }'"

[hook "gofmt"]
	event = pre-commit
	command = "bash -c 'files=$(gofmt -l . | grep -v \"^vendor/\" || true); test -z \"$files\" || { echo \"The following files need gofmt:\"; echo \"$files\"; exit 1; }'"

[hook "golangci-lint"]
	event = pre-commit
	command = "bash -c 'command -v golangci-lint >/dev/null 2>&1 || exit 0; golangci-lint run ./...'"

[hook "unit-tests"]
	event = pre-commit
	command = go test ./... -tags=unit -failfast

[hook "stripe-tests"]
	event = pre-commit
	command = "bash -c 'ROOT=$(git rev-parse --show-toplevel); test -f \"$ROOT/config.json\" && ! grep -q sk_xxx \"$ROOT/config.json\" || exit 0; go test ./... -tags=stripe -failfast -config=\"$ROOT/config.json\"'"
